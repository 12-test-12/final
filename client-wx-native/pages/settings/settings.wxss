/* ============================================================
   预警阈值页 · 墨绿磨砂玻璃
   ============================================================ */

.set-value {
  display: flex;
  align-items: baseline;
  margin: 12rpx 0 2rpx;
}
.set-num {
  font-size: 78rpx;
  font-weight: 600;
  line-height: 1.05;
  color: var(--text);
  letter-spacing: -2rpx;
}
.set-unit {
  margin-left: 10rpx;
  font-size: 24rpx;
  color: var(--text-3);
}

.range-hint {
  display: flex;
  justify-content: space-between;
  margin-top: 2rpx;
  font-size: 21rpx;
  color: var(--text-3);
}

.save-wrap {
  margin: 40rpx 28rpx 0;
}
.save-btn {
  width: 100%;
}
