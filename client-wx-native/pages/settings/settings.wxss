.page {
  padding-bottom: 40rpx;
}

/* 页头 */
.page-head {
  margin-bottom: 10rpx;
}

/* 滑块当前值 */
.slider-value {
  font-size: 56rpx;
  font-weight: 700;
  color: var(--accent);
  text-shadow: 0 0 24rpx var(--accent-glow);
  margin-bottom: 12rpx;
  line-height: 1.1;
  letter-spacing: -1rpx;
}
.slider-unit {
  font-size: 23rpx;
  font-weight: 400;
  color: var(--text-3);
  text-shadow: none;
}
.range-hint {
  display: flex;
  justify-content: space-between;
  margin-top: 10rpx;
  font-size: 21rpx;
  color: var(--text-3);
}

/* 版本信息 */
.version-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 14rpx 0;
}
.version-row + .version-row {
  border-top: 1rpx solid var(--line);
}
.version-label {
  font-size: 25rpx;
  color: var(--text-2);
}
.version-value {
  font-size: 25rpx;
  color: var(--text);
  font-weight: 600;
}

/* 保存按钮 */
.save-wrap {
  margin: 34rpx 28rpx 0;
}
.save-btn {
  width: 100%;
}
