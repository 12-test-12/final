<view class="page">
  <!-- 页头 -->
  <view class="page-head">
    <view class="page-head-title">阈值设置</view>
    <view class="page-head-sub">SETTINGS · 报警规则下发</view>
  </view>

  <view class="hint" wx:if="{{loading}}">数据加载中...</view>

  <block wx:else>
    <!-- 温度阈值 -->
    <view class="card">
      <view class="card-title">温度报警阈值</view>
      <view class="slider-value">{{temperatureHighC}} <text class="slider-unit">°C</text></view>
      <slider
        min="0"
        max="80"
        step="0.5"
        value="{{temperatureHighC}}"
        activeColor="#3df0c9"
        block-size="24"
        bindchange="onTempChange"
      />
      <view class="range-hint">
        <text>0 °C</text>
        <text>80 °C</text>
      </view>
    </view>

    <!-- 气体阈值 -->
    <view class="card">
      <view class="card-title">气体报警阈值</view>
      <view class="slider-value">{{gasHighPpm}} <text class="slider-unit">ppm</text></view>
      <slider
        min="1"
        max="999"
        step="1"
        value="{{gasHighPpm}}"
        activeColor="#3df0c9"
        block-size="24"
        bindchange="onGasChange"
      />
      <view class="range-hint">
        <text>1 ppm</text>
        <text>999 ppm</text>
      </view>
    </view>

    <!-- 版本与确认状态 -->
    <view class="card">
      <view class="card-title">下发状态</view>
      <view class="version-row">
        <text class="version-label">期望版本</text>
        <text class="version-value">{{desiredVersion}}</text>
      </view>
      <view class="version-row">
        <text class="version-label">设备确认版本</text>
        <text class="version-value">{{confirmedVersion}}</text>
      </view>
      <view class="version-row">
        <text class="version-label">确认状态</text>
        <text class="version-value {{confirmationState === 'confirmed' ? 'value-green' : 'value-amber'}}">{{confirmText}}</text>
      </view>
      <view class="version-row">
        <text class="version-label">更新时间</text>
        <text class="version-value">{{updatedAt}}</text>
      </view>
    </view>

    <view class="save-wrap">
      <button class="btn btn-primary save-btn" bindtap="onSave" loading="{{saving}}">保存并下发到设备</button>
    </view>
    <view class="hint">保存后命令经后端下发给设备，设备确认后版本号才会一致</view>
  </block>
</view>
