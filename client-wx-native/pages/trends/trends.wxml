<view class="page">
  <!-- 页头 -->
  <view class="page-head">
    <view class="page-head-title">历史趋势</view>
    <view class="page-head-sub">数据统计与曲线</view>
  </view>

  <!-- ============ 时间范围 ============ -->
  <view class="range-bar">
    <view
      wx:for="{{ranges}}"
      wx:key="*this"
      class="range-item {{activeIndex === index ? 'range-active' : ''}}"
      data-index="{{index}}"
      bindtap="onRangeTap"
      hover-class="range-hover"
      hover-stay-time="60"
    >{{item}}</view>
  </view>

  <view class="hint" wx:if="{{loading}}">数据加载中...</view>

  <block wx:if="{{stats}}">
    <!-- ============ 统计摘要（横向滑动） ============ -->
    <view class="section-head">
      <view class="section-title">统计摘要</view>
      <view class="section-tip">共 {{sampleCount}} 条样本</view>
    </view>

    <scroll-view class="stat-scroll" scroll-x enable-flex show-scrollbar="{{false}}">
      <view class="stat-scroll-inner">
        <view class="stat-card">
          <view class="stat-top">
            <text class="stat-name">温度</text>
            <text class="stat-unit">°C</text>
          </view>
          <view class="stat-main">{{stats.temp.avg}}</view>
          <view class="stat-meta">
            <view class="stat-meta-item">
              <text class="stat-meta-label">最低</text>
              <text class="stat-meta-value">{{stats.temp.min}}</text>
            </view>
            <view class="stat-meta-item">
              <text class="stat-meta-label">最高</text>
              <text class="stat-meta-value">{{stats.temp.max}}</text>
            </view>
          </view>
          <view class="stat-extreme" wx:if="{{extremes}}">峰值 {{extremes.temp.maxAt}}</view>
        </view>

        <view class="stat-card">
          <view class="stat-top">
            <text class="stat-name">湿度</text>
            <text class="stat-unit">%RH</text>
          </view>
          <view class="stat-main">{{stats.hum.avg}}</view>
          <view class="stat-meta">
            <view class="stat-meta-item">
              <text class="stat-meta-label">最低</text>
              <text class="stat-meta-value">{{stats.hum.min}}</text>
            </view>
            <view class="stat-meta-item">
              <text class="stat-meta-label">最高</text>
              <text class="stat-meta-value">{{stats.hum.max}}</text>
            </view>
          </view>
          <view class="stat-extreme" wx:if="{{extremes}}">峰值 {{extremes.hum.maxAt}}</view>
        </view>

        <view class="stat-card">
          <view class="stat-top">
            <text class="stat-name">气体</text>
            <text class="stat-unit">ppm</text>
          </view>
          <view class="stat-main">{{stats.gas.avg}}</view>
          <view class="stat-meta">
            <view class="stat-meta-item">
              <text class="stat-meta-label">最低</text>
              <text class="stat-meta-value">{{stats.gas.min}}</text>
            </view>
            <view class="stat-meta-item">
              <text class="stat-meta-label">最高</text>
              <text class="stat-meta-value">{{stats.gas.max}}</text>
            </view>
          </view>
          <view class="stat-extreme" wx:if="{{extremes}}">峰值 {{extremes.gas.maxAt}}</view>
        </view>
      </view>
    </scroll-view>

    <!-- ============ 曲线区 ============ -->
    <view class="section-head">
      <view class="section-title">曲线视图</view>
      <view class="section-tip">各指标按独立量程展示</view>
    </view>

    <view class="card chart-card">
      <view class="chart-legend">
        <view class="legend-item"><view class="legend-dot dot-temp"></view><text>温度{{chartRanges.temp !== '--' ? ' (' + chartRanges.temp + ')' : ''}}</text></view>
        <view class="legend-item"><view class="legend-dot dot-hum"></view><text>湿度{{chartRanges.hum !== '--' ? ' (' + chartRanges.hum + ')' : ''}}</text></view>
        <view class="legend-item"><view class="legend-dot dot-gas"></view><text>气体{{chartRanges.gas !== '--' ? ' (' + chartRanges.gas + ')' : ''}}</text></view>
      </view>
      <view class="chart-body">
        <canvas type="2d" id="trendsCanvas" class="trends-canvas"></canvas>
        <view class="chart-empty" wx:if="{{!hasChartData}}">
          <text>暂无历史数据</text>
        </view>
      </view>
      <view class="chart-xaxis">
        <text>{{axisTimes.start}}</text>
        <text>{{axisTimes.end}}</text>
      </view>
    </view>

    <view class="hint">三条曲线按各自量程展示，用于观察变化趋势，不用于直接比较曲线高度；数据受最近一页最多200条限制</view>
  </block>
</view>
