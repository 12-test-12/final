/* ============================================================
   自定义底部导航栏 v3 · 墨绿磨砂胶囊
   激活项：图标 + 文字展开成薄荷渐变胶囊
   ============================================================ */

.tabbar {
  position: fixed;
  left: 50%;
  transform: translateX(-50%);
  width: 600rpx;
  bottom: 28rpx;
  bottom: calc(28rpx + env(safe-area-inset-bottom));
  z-index: 999;
  padding: 10rpx;
  border-radius: 999rpx;
  background: rgba(13, 30, 26, 0.9);
  border: 1rpx solid rgba(255, 255, 255, 0.09);
  box-shadow:
    0 22rpx 48rpx rgba(0, 0, 0, 0.5),
    inset 0 1rpx 0 rgba(255, 255, 255, 0.07);
}

.tabbar-inner {
  display: flex;
  align-items: center;
}

.tab-item {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: flex 0.28s ease;
}
.tab-item-active {
  flex: 1.7;
}
.tab-item-hover {
  opacity: 0.7;
}

.tab-pill {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 76rpx;
  padding: 0 18rpx;
  border-radius: 999rpx;
  transition: all 0.28s cubic-bezier(0.34, 1.3, 0.64, 1);
}
.tab-icon {
  width: 42rpx;
  height: 42rpx;
}

/* ============ 激活状态 ============ */
.tab-item-active .tab-pill {
  padding: 0 26rpx;
  background: linear-gradient(135deg, #45f0cb 0%, #16b98b 100%);
  box-shadow: 0 12rpx 26rpx rgba(22, 185, 139, 0.34);
}
.tab-item-active .tab-icon {
  width: 36rpx;
  height: 36rpx;
}
.tab-label {
  margin-left: 10rpx;
  font-size: 24rpx;
  font-weight: 600;
  color: #04241d;
  letter-spacing: 1rpx;
}
