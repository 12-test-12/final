# Copy this file to .env.local and replace machine-specific credentials.
# The backend reads .env.local directly; shell variables with the same names do
# not override these values.

# HTTP
BACKEND_ADDR=:8080
LOG_LEVEL=info
MAX_WS_CLIENTS=128

# PostgreSQL. Leave empty only for ephemeral in-memory development.
DATABASE_URL=postgres://postgres:CHANGE_ME@localhost:5432/lab?sslmode=disable

# MQTT / EMQX
MQTT_BROKER_URL=localhost:1883
MQTT_USERNAME=backend
MQTT_PASSWORD=backend-secret
MQTT_CLIENT_ID=lab-backend
MQTT_TLS=false
MQTT_KEEPALIVE_SECONDS=30

# Local development authentication. Use bearer mode outside a trusted network.
AUTH_MODE=none
AUTH_TOKENS=
DEVICE_ALLOWLIST=MCU001

# Device liveness and command lifecycle, in whole seconds.
OFFLINE_AFTER_SECONDS=15
COMMAND_TTL_SECONDS=60
SWEEP_INTERVAL_SECONDS=5

# Composite fire-warning algorithm.
ALERT_WINDOW_SECONDS=60
ALERT_MIN_SAMPLES=6
ALERT_MIN_DURATION_SECONDS=20
ALERT_GAS_RISE_ADC=150
ALERT_TEMP_RATE_C_PER_MIN=3.0
ALERT_RECOVERY_HOLD_SECONDS=30
