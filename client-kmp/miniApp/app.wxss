page {
  --bg: #071310;
  --surface: #10231e;
  --surface-2: #17302a;
  --line: rgba(255,255,255,.09);
  --mint: #3fe8c3;
  --text: #ecf5f2;
  --muted: #8fa8a2;
  --danger: #fb7185;
  --warning: #f5c96b;
  --info: #7dd3fc;
  background: radial-gradient(800rpx 520rpx at 50% -10%, rgba(24,130,100,.30), transparent 62%), var(--bg);
  color: var(--text);
  font-family: -apple-system, BlinkMacSystemFont, 'PingFang SC', sans-serif;
}
.page { padding: 40rpx 28rpx 180rpx; }
.page-title { font-size: 46rpx; font-weight: 600; }
.page-sub { color: var(--muted); font-size: 22rpx; margin: 8rpx 0 28rpx; }
.section-head { display:flex; justify-content:space-between; align-items:baseline; margin: 36rpx 4rpx 16rpx; }
.section-title { font-size: 32rpx; font-weight:600; }
.section-tip { color:var(--muted); font-size:21rpx; }
.card { margin: 16rpx 0; padding: 30rpx; border-radius: 30rpx; background: linear-gradient(155deg,var(--surface-2),var(--surface)); border:1rpx solid var(--line); box-shadow:0 18rpx 42rpx rgba(0,0,0,.3); }
.muted { color:var(--muted); font-size:23rpx; }
.danger { color:var(--danger); }
.mint { color:var(--mint); }
.warning { color:var(--warning); }
.row { display:flex; align-items:center; justify-content:space-between; }
.pill { padding:7rpx 20rpx; border-radius:999rpx; color:var(--mint); background:rgba(63,232,195,.14); font-size:21rpx; }
.btn { margin-top:24rpx; border-radius:999rpx; background:linear-gradient(135deg,#45f0cb,#16b98b); color:#04241d; font-weight:600; }
.hint { text-align:center; color:var(--muted); padding:50rpx 0; }
.bottom-nav { position:fixed; left:0; right:0; bottom:0; height:130rpx; padding-bottom:env(safe-area-inset-bottom); display:flex; background:rgba(13,30,26,.97); border-top:1rpx solid var(--line); z-index:20; }
.nav-item { flex:1; display:flex; flex-direction:column; justify-content:center; align-items:center; color:#61786f; font-size:21rpx; }
.nav-icon { font-size:34rpx; line-height:42rpx; }
.nav-active { color:var(--mint); }

/* Tone tokens shared with the KMP runtime (`MonitoringPresentation.Tone`).
   Hosts map the same four names, so an alert can never be red on Android and
   amber here for the same backend state. */
.tone-mint .risk-text { color:var(--mint); }
.tone-warning .risk-text { color:var(--warning); }
.tone-danger .risk-text { color:var(--danger); }
.tone-info .risk-text { color:var(--info); }
.pill-mint { color:var(--mint); background:rgba(63,232,195,.14); }
.pill-warning { color:var(--warning); background:rgba(245,201,107,.16); }
.pill-danger { color:var(--danger); background:rgba(251,113,133,.16); }
.pill-info { color:var(--info); background:rgba(125,211,252,.16); }
.pill-muted { color:var(--muted); background:rgba(143,168,162,.16); }
.tone-text-mint { color:var(--mint); }
.tone-text-warning { color:var(--warning); }
.tone-text-danger { color:var(--danger); }
.tone-text-info { color:var(--info); }

/* Compact inline notice for a command that is still awaiting the device. */
.command-hint { margin-top:18rpx; padding:14rpx 20rpx; border-radius:16rpx; color:var(--warning); background:rgba(245,201,107,.12); font-size:22rpx; }
