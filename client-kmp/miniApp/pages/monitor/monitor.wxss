/* Colour comes from the shared tone token classes in app.wxss. */
.risk-row { margin:18rpx 0 8rpx; }
.risk-text { font-size:40rpx; font-weight:600; color:var(--mint); }
.meters { display:flex; gap:14rpx; }
.meter { flex:1; min-width:0; padding:24rpx 18rpx; border-radius:24rpx; background:linear-gradient(155deg,var(--surface-2),var(--surface)); border:1rpx solid var(--line); }
.meter-label { color:var(--muted); font-size:22rpx; }
.meter-value { margin:12rpx 0; font-size:42rpx; font-weight:600; }
.meter-value text { margin-left:5rpx; color:var(--muted); font-size:18rpx; font-weight:400; }
.track { height:7rpx; overflow:hidden; border-radius:99rpx; background:rgba(255,255,255,.08); }
.fill { height:100%; border-radius:99rpx; }
.temp { background:#ffa183; }.hum { background:#8ed6ff; }.gas { background:var(--mint); }
.device-name { font-size:36rpx; font-weight:600; margin-bottom:16rpx; }
.kv { display:flex; justify-content:space-between; padding:15rpx 0; border-bottom:1rpx solid rgba(255,255,255,.05); color:var(--muted); font-size:24rpx; }
.kv text:last-child { color:var(--text); font-weight:600; text-align:right; }
.control-title { font-size:30rpx; font-weight:600; }
.stats { white-space:nowrap; margin:0 -28rpx; width:750rpx; }
.stats-inner { display:flex; padding:0 28rpx; }
.stat { display:inline-flex; flex-direction:column; width:300rpx; margin-right:16rpx; }
.stat-main { display:block; font-size:58rpx; font-weight:600; margin:10rpx 0; }
.trend-row { display:flex; justify-content:space-between; padding:13rpx 0; color:var(--muted); font-size:20rpx; border-bottom:1rpx solid rgba(255,255,255,.05); }
.alert .evidence { margin-top:18rpx; padding:12rpx 18rpx; border-radius:20rpx; background:rgba(0,0,0,.18); }
.set-value { font-size:70rpx; font-weight:600; margin:10rpx 0; }
.set-value text { color:var(--muted); font-size:22rpx; }
